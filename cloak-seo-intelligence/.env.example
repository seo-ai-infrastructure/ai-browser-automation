# ─────────────────────────────────────────────────────────────────────────────
# cloak-seo-intelligence — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Letta runtime ────────────────────────────────────────────────────────────
# Base URL of the Letta server. For local docker-compose this is the default.
# For Letta Cloud, use https://api.letta.com and set LETTA_API_KEY below.
LETTA_BASE_URL=http://localhost:8283
# Only required for Letta Cloud (leave blank for a self-hosted server).
LETTA_API_KEY=

# ── Models (local-first via vMLX / MLX, OpenAI-compatible) ───────────────────
# The Letta SERVER talks to your model endpoint via these. Point OPENAI_API_BASE
# at your local vMLX / MLX server. They are consumed by the Letta container
# (see docker-compose.yml), not by this Python package directly.
OPENAI_API_BASE=http://host.docker.internal:8080/v1
OPENAI_API_KEY=local
# If you also want to allow Anthropic-hosted models, set this on the server.
ANTHROPIC_API_KEY=

# Model + embedding *handles* the agents reference. The handle must match a
# model the Letta server is configured to serve.
#   Local vMLX example : openai/<your-served-model-name>
#   Anthropic example  : anthropic/claude-sonnet-4
CLOAK_LLM_MODEL=openai/local-mlx
CLOAK_EMBEDDING_MODEL=openai/text-embedding-3-small
# Per-agent context window budget (tokens). Tune to your local model.
CLOAK_CONTEXT_WINDOW=16000

# ── Storage ──────────────────────────────────────────────────────────────────
# Redis = hot daily data + queues. Postgres = history + Letta's own DB.
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=letta
POSTGRES_PASSWORD=letta
POSTGRES_DB=letta
POSTGRES_PORT=5432

# ── Market / deployment ──────────────────────────────────────────────────────
CLOAK_MARKET_NAME=Fort Lauderdale, FL
CLOAK_MARKET_LOCATION_CODE=1015214   # DataForSEO location_code for Fort Lauderdale
CLOAK_MARKET_LANGUAGE=en

# ── External data providers (used by the data pipeline, next milestone) ──────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Search Console / Analytics / Bing (RL feedback loop outcome sources).
# Path to a GSC service-account JSON, a GA4 property id, and a Bing API key.
GSC_CREDENTIALS_JSON=
GA4_PROPERTY_ID=
BING_WEBMASTER_API_KEY=

# ── Reinforcement-learning feedback loop ─────────────────────────────────────
# Days to wait before an action is eligible for reward evaluation.
CLOAK_RL_WINDOW_DAYS=30
# Reward component weights (need not sum to 1).
CLOAK_RL_W_RANKING=0.4
CLOAK_RL_W_AIO=0.3
CLOAK_RL_W_TRAFFIC=0.2
CLOAK_RL_W_IMPRESSIONS=0.1

# ── Logging ──────────────────────────────────────────────────────────────────
CLOAK_LOG_LEVEL=INFO
